# Copy to server/.env and fill in. Never commit server/.env.

# --- Required ---
OPENAI_API_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Optional ---
PORT=3001
# Serve the built frontend (dist/) from this server. Set automatically in Docker.
# STATIC_DIR=../dist
# Comma-separated origins allowed to use Clerk tokens, e.g. https://mayelai.com
# CLERK_AUTHORIZED_PARTIES=

# --- Models ---
# OPENAI_MODEL=gpt-5-nano
# OPENAI_SEARCH_MODEL=gpt-5-search-api
# OPENAI_SUMMARY_MODEL=gpt-5-nano
# OPENAI_REASONING_EFFORT=minimal
# Specialize the assistant for your domain (keep it stable for prompt-cache discounts):
# SYSTEM_PROMPT="You are Mayel'AI, an expert in ..."

# --- Cost controls (defaults shown) ---
# MAX_OUTPUT_TOKENS=1200
# MAX_INPUT_CHARS=4000
# HISTORY_MESSAGES=10
# SUMMARY_BATCH=10
# Daily limits per plan (0 = unlimited)
# FREE_DAILY_MESSAGES=20
# FREE_DAILY_SEARCHES=2
# PRO_DAILY_MESSAGES=300
# PRO_DAILY_SEARCHES=30
# PER_MINUTE_LIMIT=15
# RESPONSE_CACHE=true
# RESPONSE_CACHE_TTL_HOURS=168

# --- Billing (Stripe). Disabled unless all three STRIPE_ values are set. ---
# Public URL of the site, used for Stripe's redirect back after paying.
# APP_URL=http://localhost:5173
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
